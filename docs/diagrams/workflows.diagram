# Generated by plotwork generate from the source workflows (github-actions: .github/workflows/publish.yml).
# The next run writes over this file. Put changes in docs/diagrams/workflows.overrides.json, or run plotwork generate --capture
# after an edit to keep it there, then run plotwork generate.
flow "publish" direction=down desc="4 jobs and their steps of the publish workflow, started by a push of a tag v*, in the order their needs set, imported from GitHub Actions."

node on terminal "Push"

group job_verify "Check the tag and the files" type=ci-cd sub="ubuntu-latest" {
  node verify_1 step "Checkout" icon=simple:github
  node verify_2 step "Setup node" icon=simple:nodedotjs
  node verify_3 step "Check that the tag names this package version"
  node verify_4 step "Check the files against checksums.txt"
  node verify_5 step "Check that the tarball carries the licence and the notices"
}

group job_publish "Publish to npm" type=ci-cd sub="ubuntu-latest" {
  node publish_1 step "Checkout" icon=simple:github
  node publish_2 step "Setup node" icon=simple:nodedotjs
  node publish_3 step "Install an npm that supports trusted publishing"
  node publish_4 step "Show the identity npm will check"
  node publish_5 step "Publish with provenance"
}

group job_release "GitHub Release" type=ci-cd sub="ubuntu-latest" {
  node release_1 step "Checkout" icon=simple:github
  node release_2 step "Create the release with the bundle and the checksums"
}

group job_smoke "Install the published version" type=ci-cd sub="ubuntu-latest" {
  node smoke_1 step "Setup node" icon=simple:nodedotjs
  node smoke_2 step "Wait for the registry to serve the version"
  node smoke_3 step "Install it and talk to it"
}

on -> verify_1
verify_1 -> verify_2
verify_2 -> verify_3
verify_3 -> verify_4
verify_4 -> verify_5
publish_1 -> publish_2
publish_2 -> publish_3
publish_3 -> publish_4
publish_4 -> publish_5
release_1 -> release_2
smoke_1 -> smoke_2
smoke_2 -> smoke_3
verify_5 -> publish_1
verify_5 -> release_1
publish_5 -> release_1
verify_5 -> smoke_1
publish_5 -> smoke_1
